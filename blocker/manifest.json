{
  "manifest_version": 3,
  "name": "Video Popup Guard",
  "version": "1.1.0",
  "description": "Stops pop-ups, invisible click-stealing layers and redirects on video sites, without blocking the site's scripts. Can swap dead player domains for working ones.",
  "permissions": ["tabs", "webNavigation", "storage", "scripting", "declarativeNetRequestWithHostAccess"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Video Popup Guard" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
